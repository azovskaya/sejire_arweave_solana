##[group]Run if ! command -v pdftotext >/dev/null; then
if ! command -v pdftotext >/dev/null; then
  sudo apt-get update
  sudo apt-get install -y poppler-utils
fi
python3 -m venv "$RUNNER_TEMP/sejire-pdf-env"
"$RUNNER_TEMP/sejire-pdf-env/bin/pip" install PyMuPDF==1.26.6
node scripts/export-layout-stress.mjs "$RUNNER_TEMP/sejire-layout" --boundaries
"$RUNNER_TEMP/sejire-pdf-env/bin/python" scripts/check-layout-pdfs.py "$RUNNER_TEMP/sejire-layout"
shell: /usr/bin/bash -e {0}
##[endgroup]
