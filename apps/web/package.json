{
  "name": "sejire-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:engine": "tsx src/lib/treeEngine.selftest.ts",
    "test:crypto": "tsx src/lib/crypto/crypto.selftest.ts && tsx src/lib/crypto/backup.selftest.ts",
    "test:kinship": "tsx src/lib/kinship.selftest.ts",
    "test:pedigree": "tsx src/lib/pedigree.selftest.ts",
    "test:lineage": "tsx src/lib/pdf/lineage.selftest.ts",
    "test:thirteen": "tsx src/lib/pdf/thirteenLineage.fixture.selftest.ts",
    "test:dates": "tsx src/lib/dates.selftest.ts",
    "test:json": "tsx src/lib/treeJson.selftest.ts",
    "test:zhuz": "tsx src/lib/zhuzRu.selftest.ts",
    "test:sponsor": "tsx src/lib/sponsor/client.selftest.ts",
    "test:loadVault": "tsx src/lib/arweave/loadVault.selftest.ts",
    "test:mirror": "tsx src/lib/siteMirror.selftest.ts",
    "test:lastScreen": "tsx src/lib/lastScreen.selftest.ts",
    "test:fetch": "tsx src/lib/arweave/fetch.selftest.ts",
    "test:gateways": "tsx src/lib/arweave/gateways.selftest.ts",
    "test:storage": "tsx src/lib/storageQuota.selftest.ts",
    "test:archive": "tsx src/lib/vaultSession/localArchive.selftest.ts",
    "test:protocol": "tsx src/lib/ao/protocol.selftest.ts",
    "test:i18n": "tsx src/lib/i18n/i18n.selftest.ts",
    "test:opsDesk": "tsx src/lib/opsDesk/store.selftest.ts && tsx src/lib/opsDesk/networkOverview.selftest.ts",
    "test": "npm run test:engine && npm run test:crypto && npm run test:kinship && npm run test:pedigree && npm run test:lineage && npm run test:thirteen && npm run test:dates && npm run test:json && npm run test:zhuz && npm run test:sponsor && npm run test:loadVault && npm run test:mirror && npm run test:lastScreen && npm run test:fetch && npm run test:gateways && npm run test:storage && npm run test:archive && npm run test:protocol && npm run test:i18n && npm run test:opsDesk && npm run test:solana && npm run test:native && npm run test:v2 && npm run test:recovery",
    "test:v2": "tsx src/lib/preserveV2/v2.selftest.ts && tsx src/lib/preserveV2/machine.selftest.ts",
    "test:v2-browser": "playwright test --config playwright.v2.config.ts",
    "test:v2-recovery-browser": "playwright test --config playwright.v2-recovery.config.ts",
    "test:solana": "tsx src/lib/solana/policy.selftest.ts && tsx src/lib/solana/wallet.selftest.ts && tsx src/lib/solana/upload.selftest.ts && tsx src/lib/solana/receipt.selftest.ts && tsx src/lib/solana/boundaries.selftest.ts",
    "test:solana:live": "tsx src/lib/solana/devnet.e2e.ts",
    "test:checkout-browser": "playwright test",
    "test:native": "tsx src/lib/native/native.selftest.ts",
    "test:native-browser": "playwright test --config playwright.native.config.ts",
    "test:native-pilot-browser": "playwright test --config playwright.pilot.config.ts",
    "test:native-journey": "playwright test --config playwright.journey.config.ts",
    "test:recovery": "tsx src/lib/recovery/recovery.selftest.ts",
    "test:admin-browser": "playwright test --config playwright.admin-password.config.ts"
  },
  "dependencies": {
    "@ardrive/turbo-sdk": "2.1.0",
    "@dha-team/arbundles": "1.0.4",
    "@fontsource/work-sans": "^5.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@solana/web3.js": "1.99.0",
    "arweave": "^1.15.7",
    "bs58": "5.0.0",
    "jspdf": "^4.0.0",
    "node-forge": "^1.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.13.2",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "6.2.4",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "overrides": {
    "elliptic": "6.6.1",
    "ws@^7.0.0": "7.5.11",
    "secp256k1@5.0.0": "5.0.1"
  }
}
