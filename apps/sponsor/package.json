{
  "name": "sejire-sponsor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx src/selftest.ts && npm run test:checkout && npm run test:rpc",
    "dev": "echo 'Use: npx wrangler dev (Cloudflare login). Default PAYMENT_PROVIDER=mock.'",
    "test:checkout": "tsx src/checkout/selftest.ts",
    "test:rpc": "tsx src/checkout/rpc.selftest.ts",
    "test:sqlite": "node tests/sqlite-runtime.mjs",
    "test:api": "node tests/api-runtime.mjs",
    "test:preservation": "tsx src/checkout/preparation.selftest.ts && tsx src/checkout/preservation.selftest.ts",
    "test:protocol": "tsx src/protocol/selftest.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@types/node": "^18.19.130",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@dha-team/arbundles": "1.0.4",
    "arweave": "^1.15.7",
    "bs58": "5.0.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    },
    "elliptic": "6.6.1",
    "@ethersproject/providers": {
      "ws": "7.5.11"
    },
    "ws@^7.0.0": "7.5.11",
    "secp256k1@5.0.0": "5.0.1"
  }
}
