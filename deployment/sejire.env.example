# Public runtime configuration. Copy to ignored sejire.env on the owner's host.
# This template intentionally cannot accept payments or publish archives.
SEJIRE_LINUX_HOST=0.0.0.0
SEJIRE_LINUX_PORT=8787
SEJIRE_LINUX_DB=/data/sejire.sqlite
SEJIRE_BUILD_COMMIT=
SEJIRE_BACKUP_DIR=/data/backups
SEJIRE_BACKUP_INTERVAL_MS=3600000
SEJIRE_BACKUP_RETAIN=48

# Exact externally served site origins. Add a review origin explicitly if used.
CHECKOUT_ALLOWED_ORIGINS=https://sejire.ar.io
# Use only documented ingress CIDRs. Empty means socket address only;
# forwarding headers supplied by an arbitrary client are ignored.
SEJIRE_TRUSTED_PROXY_CIDRS=

CHECKOUT_API_ENABLED=false
CHECKOUT_PAID_ENABLED=false
CHECKOUT_PAID_EXECUTION_ENABLED=false
CHECKOUT_CONTRIBUTION_ENABLED=false
FUND_API_ENABLED=false
CHECKOUT_PAID_NETWORK=mainnet-beta
CHECKOUT_PAID_POLICY_VERSION=sejire-mainnet-v1
MAX_ENVELOPE_BYTES=524288

# Public addresses are supplied and independently confirmed by the owner.
# Service and optional contribution recipients MUST differ.
CHECKOUT_SERVICE_RECIPIENT=
CHECKOUT_FUND_RECIPIENT=
CHECKOUT_PAID_TREASURY_ADDRESS=qgoIFw9WsusMRapWzcFg4jNW08HSWvQkpAKOz86BUuI
# Preserve the existing paid budget identity during a migration.
CHECKOUT_PAID_AR_BUDGET_ID=
CHECKOUT_PAID_AR_BUDGET_WINSTON=
CHECKOUT_PAID_MAX_REWARD_WINSTON=
# Two independent, HTTPS Mainnet RPCs, per the provider's supported format.
CHECKOUT_SOLANA_RPC_URLS=

# Secret values are entered only in the owner's hosting secret store.
# Keep the old promo HMAC secret and treasury key when migrating obligations.
# Never send these values, seed words or private backups to a chat or Git.
ADMIN_TOKEN=
PROMO_CODE_SECRET=
ARWEAVE_TREASURY_JWK=
