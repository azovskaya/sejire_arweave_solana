# Non-secret settings for a NEW, EMPTY, closed SEJIRE host only.
# Do not use the admission flags as a stop switch for an imported ledger.
# Operator pack; not an automatically applied deployment.
SEJIRE_LINUX_HOST=0.0.0.0
SEJIRE_LINUX_PORT=8787
SEJIRE_LINUX_DB=/data/sejire.sqlite
SEJIRE_BUILD_COMMIT=ef0252025c32687dce018368ea94d74af2728c66
SEJIRE_BACKUP_DIR=/data/backups
SEJIRE_BACKUP_INTERVAL_MS=3600000
SEJIRE_BACKUP_RETAIN=48
CHECKOUT_ALLOWED_ORIGINS=https://sejire.ar.io
SEJIRE_TRUSTED_PROXY_CIDRS=
CHECKOUT_API_ENABLED=false
CHECKOUT_PAID_ENABLED=false
CHECKOUT_PAID_EXECUTION_ENABLED=false
CHECKOUT_CONTRIBUTION_ENABLED=false
FUND_API_ENABLED=false
CHECKOUT_PAID_NETWORK=mainnet-beta
CHECKOUT_PAID_POLICY_VERSION=sejire-mainnet-v1
MAX_ENVELOPE_BYTES=524288

# ADMIN_TOKEN, PROMO_CODE_SECRET and ARWEAVE_TREASURY_JWK must be ABSENT.
