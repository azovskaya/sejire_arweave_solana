{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sejire:envelope:v1:offline-recovery",
  "title": "SEJIRE encrypted vault envelope v1",
  "description": "Matches the deployed envelope parser. Base64 length must also be divisible by four; JSON Schema does not express that constraint here. No network resolution of this identifier is required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "vault_id", "cipher", "kdf", "iv", "ciphertext", "protocol"],
  "properties": {
    "schema": { "const": "sejire/envelope/v1" },
    "vault_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "cipher": { "const": "aes-gcm-256" },
    "kdf": { "const": "hkdf-sha256" },
    "iv": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" },
    "ciphertext": { "type": "string", "minLength": 24, "maxLength": 10485760, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "protocol": { "const": "sejire/v0.3" }
  }
}
